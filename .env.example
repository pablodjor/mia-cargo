# Copiá a .env.local para probar la demo compartida con `netlify dev`
# En Netlify ya está activado vía netlify.toml (VITE_DEMO_REMOTE_STORAGE=true)

# Usar base compartida en la nube (Netlify Functions + Blobs) en lugar de localStorage
VITE_DEMO_REMOTE_STORAGE=true

# Opcional: Google Maps
# VITE_GOOGLE_MAPS_API_KEY=
